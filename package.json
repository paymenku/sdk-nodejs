{
  "name": "@paymenku/sdk-nodejs",
  "version": "0.1.0",
  "description": "SDK Node.js untuk API Paymenku — QRIS, Virtual Account, e-wallet, payment link, dan wallet",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/fix-cjs.mjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "npm run build && node --test test/client.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paymenku/sdk-nodejs.git"
  },
  "homepage": "https://github.com/paymenku/sdk-nodejs#readme",
  "bugs": {
    "url": "https://github.com/paymenku/sdk-nodejs/issues"
  },
  "keywords": [
    "paymenku",
    "payment-gateway",
    "qris",
    "virtual-account",
    "ewallet",
    "indonesia"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
